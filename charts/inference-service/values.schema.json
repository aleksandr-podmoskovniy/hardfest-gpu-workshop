{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "order"
  ],
  "properties": {
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "spec"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inferenceServiceClassName",
            "launchStrategy",
            "model",
            "resources"
          ],
          "properties": {
            "inferenceServiceClassName": {
              "type": "string",
              "minLength": 1
            },
            "launchStrategy": {
              "enum": [
                "Latency",
                "Throughput"
              ]
            },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "src",
                "ref"
              ],
              "properties": {
                "src": {
                  "enum": ["ai-models", "HuggingFace"]
                },
                "ref": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "Model",
                        "ClusterModel"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "namespace": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {"properties": {"src": {"const": "ai-models"}}},
                  "then": {"properties": {"ref": {"required": ["kind"]}}},
                  "else": {"properties": {"ref": {"not": {"anyOf": [{"required": ["kind"]}, {"required": ["namespace"]}]}}}}
                }
              ]
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "accelerator"
              ],
              "properties": {
                "accelerator": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "deviceClasses"
                  ],
                  "properties": {
                    "deviceClasses": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
